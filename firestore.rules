rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'admin';
    }

    function isModerator() {
      return isAuthenticated() && getUserRole() == 'moderator';
    }

    function isAdminOrModerator() {
      return isAdmin() || isModerator();
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;

      // Users can update their own doc (but not role or status fields)
      // Admins and moderators can update any user doc
      allow update: if isAuthenticated() && (
        (request.auth.uid == userId &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'banExpiry'])) ||
        isAdminOrModerator()
      );

      // Only admins and moderators can delete user accounts
      allow delete: if isAdminOrModerator();

      // User notifications subcollection
      match /notifications/{notificationId} {
        allow read: if isAuthenticated() && request.auth.uid == userId;
        allow create: if isAdminOrModerator();
        allow update: if isAuthenticated() && request.auth.uid == userId;
        allow delete: if false;
      }
    }

    // Blogs collection
    match /blogs/{blogId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
          request.resource.data.keys().hasAll([
            'title',
            'domainLink',
            'uploadedAt',
            'uploadedBy',
            'location',
            'tags'
          ]) &&
          request.resource.data.uploadedBy == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.uploadedBy == request.auth.uid ||
        isAdminOrModerator()
      );
      allow delete: if isAuthenticated() && (
        resource.data.uploadedBy == request.auth.uid ||
        isAdminOrModerator()
      );
    }

    // Moderation logs collection — audit trail
    match /moderation_logs/{logId} {
      allow read: if isAdminOrModerator();
      allow create: if isAdminOrModerator()
        || (isAuthenticated() && request.resource.data.actionType == 'automod_block');
      allow update, delete: if false;
    }

    // Reports collection
    match /reports/{reportId} {
      allow read: if isAdminOrModerator();
      allow create: if isAuthenticated() && request.resource.data.reporterId == request.auth.uid;
      allow update: if isAdminOrModerator();
      allow delete: if false;
    }
  }
}
